# PostgreSQL connection string (ALWAYS use a dedicated read-only role in production)
DATABASE_URL=postgresql://nl2sql_ro:nl2sql_ro_demo_pass@127.0.0.1:55432/nl2sql_demo

# Google Gemini API Key (leave empty to run in local Demo/Heuristic NL2SQL mode)
GEMINI_API_KEY=

# Gemini model configuration
GEMINI_LINKER_MODEL=gemini-2.5-flash
GEMINI_GENERATOR_MODEL=gemini-2.5-pro

# Safety & execution limits
STATEMENT_TIMEOUT_MS=10000
DEFAULT_ROW_LIMIT=200
MAX_ROW_LIMIT=1000
MAX_REPAIR_ATTEMPTS=3

# Schema profiling configuration
SCHEMA_NAME=public
PROFILE_SAMPLE_LIMIT=500
LOW_CARDINALITY_LIMIT=25
GLOSSARY_PATH=glossary.yaml
